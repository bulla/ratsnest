{
  "name": "ratsnest",
  "version": "0.0.0",
  "description": "Graphical wiring for breadboards: a wiring guide for every circuit, drawn the same way",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.5",
  "repository": {
    "type": "git",
    "url": "https://github.com/bulla/ratsnest.git"
  },
  "scripts": {
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
