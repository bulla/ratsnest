    "fonts": "bun scripts/fonts.ts"
  },
  "dependencies": {
    "@babel/parser": "8.1.3",
    "fontkit": "3.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@types/bun": "1.4.5",
    "@types/jsdom": "30.0.0",
    "jsdom": "31.0.1",
    "typescript": "7.0.2"
  }
}
